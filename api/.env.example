# Copy to .env and fill in values. Never commit .env.

APP_NAME=pexm-exams-api
DEBUG=false

# MySQL 8+ (caching_sha2_password) requires the cryptography package (see pyproject.toml).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pexm_exams
DB_USER=root
DB_PASSWORD=root
# Optional TLS. Set DB_SSL_CA alone for server-only verification, or all
# three for mutual TLS (DB_SSL_CERT and DB_SSL_KEY must be set together).
# DB_SSL_CA=/path/to/ca.pem
# DB_SSL_CERT=/path/to/client-cert.pem
# DB_SSL_KEY=/path/to/client-key.pem

CORS_ORIGINS=http://localhost:3000

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Single Redis instance shared across all horizontally-scaled app instances.
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5.0
REDIS_CONNECT_TIMEOUT=5.0

# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# LOG_FORMAT: json | console. Leave commented out to auto-select
# (console when DEBUG=true, json otherwise).
# LOG_FORMAT=console
